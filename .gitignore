# Python cache / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
downloads/
wheels/
sdist/

# Virtual environments / local env files
.venv/
venv/
env/
.env
.env.*

# OpenFrequency runtime configuration and logs
config.json
llm_error.txt
logs/
*.log
openfrequency_*.log
flight_log_*.txt
track_*.csv
cabin_*.csv

# Generated audio / recordings / reports
debug_tts.mp3
temp_audio/
recordings/
reports/
screenshots/
*.webm
*.wav

# Local data caches and user state
data/airport_data/
data/career/
data/ground_cache/
data/reports/

# Keep reusable project data tracked explicitly.
!data/
!data/chatter_templates.json
!data/cabin/
!data/cabin/scripts.json
!data/locales/
!data/locales/*.json

# User-provided cabin media can be large or copyrighted.
static/cabin_media/

# Large downloaded binaries and models
ffmpeg/
models/
sherpa-onnx-whisper*/
*.bin
*.dll
*.onnx
*.zip

# Local executables, except PyInstaller project metadata.
*.exe
*.spec.bak

# Temporary development scratch files
tmp_*.js
tmp_*.py
test_wavs/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
.DS_Store
.claude